# --- Service ---
PORT=3005
SERVICE_NAME=subscription
LOG_LEVEL=info

# --- Base de données propre au service ---
DATABASE_URL=postgresql://polyshop:polyshop@localhost:5432/subscriptions

# --- Auth : même secret et issuer que les autres services (JWT HS256) ---
JWT_SECRET=change-me-in-production-at-least-32-characters
JWT_ISSUER=polyshop-auth

# --- Redis Streams ---
REDIS_URL=redis://localhost:6379
EVENTS_STREAM=polyshop:events

# --- Service payment (contrat inter-groupes) ---
PAYMENT_URL=http://localhost:3006
PAYMENT_TIMEOUT_MS=2000
PAYMENT_RETRIES=2

# --- HTTP ---
CORS_ORIGINS=http://localhost:5173
