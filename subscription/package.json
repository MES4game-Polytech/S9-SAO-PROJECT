    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio"
  },
  "license": "CC-BY-SA-4.0",
  "dependencies": {
    "@nestjs/common": "^12.4.0",
    "@nestjs/core": "^12.4.0",
