# --- Service ---
PORT=3004 #doit être différent des autres micro-services
SERVICE_NAME = registration
LOG_LEVEL=info

# --- Base de données du service ---
DATABASE_URL=postgresql://polybird:polybird@localhost:5432/registration #emplacement de la bd

# --- Auth ---
JWT_SECRET=change-me-in-production-at-least-32-characters #doit-être la même que auth (pour authentifier les jetons)
JWT_ISSUER=polybird-auth #celui qui émet le jeton

# --- Redis Stream ---
REDIS_URL=redis://localhost:6379
EVENTS_STREAM=polybird:events

# --- Service Event ---
EVENT_URL = http://localhost:3003 #à changer selon le choix pour le service
EVENT_TIMEOUT_MS=2000
EVENT_RETRIES=2

# --- HTTP ---
CORS_ORIGINS=http://localhost:5173 #adresse du frontend, défini ceux qui ont le droit d'interroger le service